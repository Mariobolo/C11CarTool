<?xml version="1.0" encoding="utf-8"?>
<!--
  统一空白占位图标
  用于所有模块的图标位置，后期可逐个替换为具体功能图标
  设计：圆角方形背景 + 居中虚线框（表示预留位置）
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景：圆角方形 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A3050"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <!-- 居中虚线框：表示图标预留位置 -->
    <item
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#4A5580"
                android:dashWidth="4dp"
                android:dashGap="3dp"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</layer-list>
